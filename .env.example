DATABASE_URL=postgres://postgres:postgres@localhost:55432/wagering
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
WAGER_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wallet-events.fifo
PORT=3000

# Optional tuning (defaults shown; see src/infrastructure/config/env.ts)
# CONSUMER_NAME=wager-transactions-consumer
# SQS_VISIBILITY_TIMEOUT_S=30
# SQS_MAX_RECEIVE=5
# SHUTDOWN_GRACE_MS=20000
# OUTBOX_BATCH=50
# OUTBOX_POLL_MS=250
# PENDING_REF_BATCH=20
# PENDING_REF_POLL_MS=500
# PENDING_REF_MAX_ATTEMPTS=10
# PENDING_REF_TTL_MS=900000
# DB_POOL_MAX=20
# JITTER=on
# LOG_LEVEL=info
# AUTH_MODE=none

# Optional Keycloak auth (README "Autenticação"): `docker compose --profile auth up -d --wait keycloak`, then
# AUTH_MODE=keycloak
# KEYCLOAK_ISSUER=http://localhost:8080/realms/wagering
# KEYCLOAK_JWKS_URL=http://localhost:8080/realms/wagering/protocol/openid-connect/certs
